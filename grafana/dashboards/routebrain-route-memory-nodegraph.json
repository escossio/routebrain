      "id": 1,
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "RouteBrain transforma medições de rota em memória operacional, identifica trechos compartilhados, edges comuns e divergências estruturais. Este dashboard consome views read-only geradas pelo RouteBrain SDK."
      }
    },
    {
      "type": "stat",
      "title": "Routes",
      "id": 2,
      "datasource": "${DS_ROUTEBRAIN_POSTGRES}",
