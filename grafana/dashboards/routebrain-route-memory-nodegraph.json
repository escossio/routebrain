{
  "uid": "routebrain-route-memory",
  "title": "RouteBrain Route Memory",
  "tags": ["routebrain", "routememory", "network", "grafana"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_ROUTEBRAIN_POSTGRES",
        "type": "datasource",
        "query": "postgres",
        "current": {
          "selected": false,
          "text": "PostgreSQL",
          "value": "PostgreSQL"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "graph_uid",
        "type": "query",
        "datasource": "${DS_ROUTEBRAIN_POSTGRES}",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "query": "SELECT graph_uid FROM route_memory_grafana_summary ORDER BY created_at DESC;",
        "current": {
          "selected": true,
          "text": "latest",
          "value": "latest"
        },
        "options": []
      }
    ]
  },
