      "targets": [
        {
          "refId": "A",
          "format": "table",
        "rawSql": "SELECT 'routes_count' AS metric, routes_count AS value FROM route_memory_grafana_summary_latest;",
          "datasource": "${DS_ROUTEBRAIN_POSTGRES}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
